{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  dependencyDashboard: true,
  // the server/pom.xml <parent> points at this repo's own root pom.xml,
  // it's never published so Renovate can't (and shouldn't) look it up
  ignoreDeps: [
    'io.kroki:kroki',
  ],
  labels: [
    '🔗 dependencies',
  ],
  separateMajorMinor: true,
  // the "Diagram library versions" workflow pushes a changelog entry to the Renovate branches:
  // keep updating (rebasing) these branches anyway
  gitIgnoredAuthors: [
    '41898282+github-actions[bot]@users.noreply.github.com',
  ],
  // wait at least 7 days after a release before proposing it
  minimumReleaseAge: '7 days',
  // batch all PRs on monday morning instead of creating them continuously
  timezone: 'Europe/Paris',
  schedule: [
    'before 6am on monday',
  ],
  // major updates wait for manual approval from the dependency dashboard
  major: {
    dependencyDashboardApproval: true,
  },
  // avoid PR bursts and cascading rebases
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
  extends: [
    ':preserveSemverRanges',
  ],
  // security fixes should not wait
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
  },
  // PLANTUML_VERSION is a plain ARG (not a FROM tag) used to download the native
  // PlantUML binary, so it needs a custom manager to be tracked at all
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^server/ops/docker/Dockerfile$/',
      ],
      matchStrings: [
        'ARG PLANTUML_VERSION="(?<currentValue>.*?)"',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'plantuml/plantuml',
      // plain "vX.Y.Z" tags only: excludes the "snapshot"/"snapshot-native"
      // pre-release tags (GitHub-flagged prereleases, filtered anyway by the
      // ignoreUnstable rule below) as well as the "-native" variant tags that
      // are a different release flavour and would break the download URL
      extractVersionTemplate: '^v(?<version>\\d+\\.\\d+\\.\\d+)$',
    },
    // D2_VERSION is a plain ARG used to download the d2 binary from GitHub releases
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^server/ops/docker/Dockerfile$/',
      ],
      matchStrings: [
        'ARG D2_VERSION="(?<currentValue>.*?)"',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'd2lang/d2',
      // tags are "vX.Y.Z", the Dockerfile stores the bare version
      extractVersionTemplate: '^v(?<version>.*)$',
    },
    // ARG VERSION in tools/<tool>/Dockerfile is the upstream version of a tool published as an image
    // by the "Tool images" workflow, annotated with a "# renovate: ..." comment on the line above
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^tools/[^/]+/Dockerfile$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( registryUrl=(?<registryUrl>\\S+))?( extractVersion=(?<extractVersion>\\S+))?\\s+ARG VERSION=(?<currentValue>\\S+)',
      ],
    },
    // the diagram library versions are also reported by the getVersion() method of the Java services
    // (used by /health, as the HTTP cache key and by the tests to download the PlantUML binary)
    // and in docs/antora.yml, annotated with a "renovate: ..." comment on the line above:
    // Renovate updates them in the same pull request as the dependency manifest
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^server/src/main/java/io/kroki/server/service/[^/]+\\.java$/',
        '/^docs/antora\\.yml$/',
      ],
      matchStrings: [
        '// renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( extractVersion=(?<extractVersion>\\S+))?\\s+return "(?<currentValue>[^"]+)";',
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( extractVersion=(?<extractVersion>\\S+))?\\s+[a-z0-9]+-version: (?<currentValue>[^\\s\']+)',
      ],
    },
  ],
  packageRules: [
    {
      // datasource rather than manager: also matches the svgbob and lini versions annotated in the Java services and docs/antora.yml
      "matchDatasources": ["crate"],
      "groupName": "Rust crate",
      "versioning": "cargo",
      "rangeStrategy": "bump"
    },
    {
      matchManagers: [
        'github-actions',
      ],
      groupName: 'GitHub Actions',
    },
    {
      matchManagers: [
        'dockerfile',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
      matchPackageNames: [
        '/node/',
      ],
    },
    {
      matchManagers: [
        'dockerfile',
      ],
      groupName: 'Docker images',
    },
    // the tool image versions annotated in the Java services and docs/antora.yml
    // must land in the same pull request as the Dockerfile FROM instructions
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/yuzutech/kroki-builder-*',
      ],
      groupName: 'Docker images',
    },
    // tools/<tool>/Dockerfile builds binaries that run in the Kroki image, so their Ubuntu release
    // must match the one of the Kroki base image (eclipse-temurin:<version>-noble): move them together, by hand
    {
      matchManagers: [
        'dockerfile',
      ],
      matchFileNames: [
        'tools/**',
      ],
      matchPackageNames: [
        'ubuntu',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
    },
    {
      matchManagers: [
        'pip_requirements',
      ],
      groupName: 'Python dependencies',
    },
    {
      matchManagers: [
        'npm',
      ],
      groupName: 'Node dependencies',
    },
    // each diagram library lives in its own service directory; group updates
    // per directory so e.g. a bpmn-js bump doesn't wait on / get bundled with
    // an unrelated wavedrom bump (overrides the generic "Node dependencies"
    // bucket above for these specific files)
    {
      matchManagers: [
        'npm',
      ],
      matchFileNames: [
        'mermaid/package.json',
      ],
      groupName: 'Mermaid',
    },
    {
      matchManagers: [
        'npm',
      ],
      matchFileNames: [
        'bpmn/package.json',
      ],
      groupName: 'bpmn-js',
    },
    {
      matchManagers: [
        'npm',
      ],
      matchFileNames: [
        'nomnoml/package.json',
      ],
      groupName: 'nomnoml',
    },
    {
      matchManagers: [
        'npm',
      ],
      matchFileNames: [
        'bytefield/package.json',
      ],
      groupName: 'Bytefield',
    },
    {
      matchManagers: [
        'npm',
      ],
      matchFileNames: [
        'wavedrom/package.json',
      ],
      groupName: 'WaveDrom',
    },
    {
      matchManagers: [
        'npm',
      ],
      matchFileNames: [
        'excalidraw/package.json',
      ],
      groupName: 'Excalidraw',
    },
    {
      matchManagers: [
        'npm',
      ],
      matchFileNames: [
        'dbml/package.json',
      ],
      groupName: 'DBML',
    },
    // @biomejs/biome, esbuild, postject and the volta node pin are identical
    // build tooling duplicated across every diagram-library package.json
    // (mermaid/, bpmn/, wavedrom/, ...). Without this rule each directory's
    // groupName above would bundle these internal-only bumps together with
    // the actual diagram library version (e.g. PR #2122 mixed a wavedrom
    // bump with @biomejs/biome, esbuild and node), which is wrong per the
    // changelog rule: library bumps are user-visible, tooling bumps aren't.
    // Placed after the per-directory rules so it wins on groupName for
    // these package names and collapses them into one shared PR.
    {
      matchManagers: [
        'npm',
      ],
      matchPackageNames: [
        '@biomejs/biome',
        'esbuild',
        'postject',
        'node',
      ],
      groupName: 'Build tooling',
    },
    // the diagram library versions annotated in the Java services and docs/antora.yml
    // are not matched by the per-directory rules above (different manager and file):
    // give them the same groupName so they land in the same pull request as the package.json
    {
      matchPackageNames: [
        'mermaid',
      ],
      groupName: 'Mermaid',
    },
    {
      matchPackageNames: [
        'bpmn-js',
      ],
      groupName: 'bpmn-js',
    },
    {
      matchPackageNames: [
        'nomnoml',
      ],
      groupName: 'nomnoml',
    },
    {
      matchPackageNames: [
        'bytefield-svg',
      ],
      groupName: 'Bytefield',
    },
    {
      matchPackageNames: [
        'wavedrom',
      ],
      groupName: 'WaveDrom',
    },
    {
      matchPackageNames: [
        '@excalidraw/excalidraw',
      ],
      groupName: 'Excalidraw',
    },
    {
      matchPackageNames: [
        '@softwaretechnik/dbml-renderer',
      ],
      groupName: 'DBML',
    },
    // vega and vega-lite are tracked via vega/deno.json (Renovate's "imports"
    // manager, not "npm"), so they're already excluded from the "Node
    // dependencies" bucket above and get one PR per package by default —
    // no rule needed here to keep them independent of each other.
    {
      matchManagers: [
        'npm',
      ],
      enabled: false,
      matchPackageNames: [
        '/puppeteer/',
      ],
    },
    {
      // lockfile regeneration resolves versions published at least 14 days ago
      // (Renovate passes --before to npm, covering transitive dependencies too)
      matchManagers: [
        'npm',
      ],
      matchUpdateTypes: [
        'lockFileMaintenance',
      ],
      minimumReleaseAge: '14 days',
    },
    {
      matchManagers: [
        'maven',
      ],
      groupName: 'Java dependencies',
    },
    {
      matchManagers: [
        'maven',
      ],
      groupName: 'Java testing packages',
      matchPackageNames: [
        '/^org.mockito/',
        '/^org.junit.jupiter/',
        '/^org.assertj/',
      ],
    },
    {
      matchManagers: [
        'maven',
      ],
      groupName: 'Maven plugins',
      matchPackageNames: [
        '/^org.apache.maven.plugins/',
      ],
    },
    {
      // no matchManagers: also matches the Structurizr version annotated in Structurizr.java and docs/antora.yml
      groupName: 'Structurizr packages',
      matchPackageNames: [
        '/^com.structurizr/',
      ],
    },
    {
      // the Dockerfile, Plantuml.java and docs/antora.yml (plantuml and c4plantuml) versions
      // are updated together in a single pull request
      matchDepNames: [
        'plantuml/plantuml',
      ],
      matchDatasources: [
        'github-releases',
      ],
      groupName: 'PlantUML',
      // belt-and-suspenders: never suggest the "snapshot" pre-release, only
      // the latest stable tag, even though extractVersionTemplate already
      // filters it out
      ignoreUnstable: true,
    },
  ],
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
  },
}
