@@ -0,0 +1,21 @@
+package d2cli
+
+import (
+	"context"
+	"io/fs"
+)
+
+// noLocalFilesKey marks a context in which the diagram must not read local files (--allow-local-files=false).
+type noLocalFilesKey struct{}
+
+func noLocalFiles(ctx context.Context) bool {
+	v, _ := ctx.Value(noLocalFilesKey{}).(bool)
+	return v
+}
+
+// denyFS rejects every import, without revealing whether the file exists.
+type denyFS struct{}
+
+func (denyFS) Open(name string) (fs.File, error) {
+	return nil, &fs.PathError{Op: "open", Path: name, Err: fs.ErrPermission}
+}
